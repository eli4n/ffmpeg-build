# How fetch-sources.sh recognises the sources it downloads. Sourced by bash.

# FFmpeg signs every release with this key. The fingerprint is published at
# https://ffmpeg.org/download.html#releases; the key itself is ffmpeg-devel.asc
# in this repository. Only a signature whose primary key is exactly this one is
# accepted.
FFMPEG_KEY_FPR=FCF986EA15E6E293A5644F10B4322F04D67658D8

# LAME does not sign its releases. The hash was cross-checked against the
# sha512 in Alpine's APKBUILD (main/lame).
LAME_VERSION=3.100
LAME_SHA256=ddfe36cab873794038ae2c1210557ad34857a4b6bdc515785d1da9e175b1da1e

# Matches the digest GitHub reports for the release asset and the sha512 in
# Alpine's APKBUILD (main/zlib).
ZLIB_VERSION=1.3.2
ZLIB_SHA256=bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16
